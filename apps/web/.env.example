# For running the web app outside Docker (npm run dev) against the compose
# services. Copy to apps/web/.env.local. Use the passwords from the root .env.
APP_URL=http://localhost:3000
DATABASE_OWNER_URL=postgres://selah_owner:CHANGE_ME@localhost:5432/selah
DATABASE_APP_URL=postgres://selah_app:CHANGE_ME@localhost:5432/selah
DATABASE_AUTH_URL=postgres://selah_auth:CHANGE_ME@localhost:5432/selah
BETTER_AUTH_SECRET=
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=selah-evidence
S3_ACCESS_KEY=selah
S3_SECRET_KEY=
# Virus scanner (docker compose up clamav). Uploads are refused while it is
# unreachable. SCAN_REQUIRED=false accepts files unscanned: local use only.
CLAMD_HOST=localhost
SCAN_REQUIRED=true
# PDF exports (Gotenberg). In compose it has no published port; for local
# development run one:  docker run --rm -p 127.0.0.1:3001:3000 gotenberg/gotenberg:8.38.1-chromium gotenberg --chromium-disable-javascript=true
# Leave empty to hide the PDF buttons.
PDF_SERVICE_URL=
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=
SEED_PASSWORD=
# Mail (npm run job:mail). Leave SMTP_URL empty to print mails instead of sending.
SMTP_URL=
MAIL_FROM=
# Integration tests (npm run test:db) use a separate, disposable database.
TEST_DATABASE_OWNER_URL=postgres://selah_owner:CHANGE_ME@localhost:5432/selah_test
TEST_DATABASE_APP_URL=postgres://selah_app:CHANGE_ME@localhost:5432/selah_test
TEST_DATABASE_AUTH_URL=postgres://selah_auth:CHANGE_ME@localhost:5432/selah_test
