# Copy to .env (for docker compose) and fill every value.
# Generate secrets with:  openssl rand -base64 32
# Never commit .env. Use sample data only until real client data is approved.

POSTGRES_PASSWORD=
SELAH_OWNER_PASSWORD=
SELAH_APP_PASSWORD=
SELAH_AUTH_PASSWORD=

BETTER_AUTH_SECRET=
AI_SERVICE_TOKEN=

S3_ACCESS_KEY=selah
S3_SECRET_KEY=
S3_BUCKET=selah-evidence

APP_URL=http://localhost:3000

# The way in (docs/operations.md, "How traffic reaches it"): leave empty for
# a local install, "tunnel" for Cloudflare Tunnel, "direct" for HTTPS on this
# server's own ports 80 and 443 (required before any real client file).
# APP_URL becomes https://SITE_DOMAIN and S3_PUBLIC_ENDPOINT https://FILES_DOMAIN.
COMPOSE_PROFILES=
SITE_DOMAIN=
FILES_DOMAIN=
S3_PUBLIC_ENDPOINT=
CLOUDFLARE_TUNNEL_TOKEN=

# The server's mail relay and sender (invitations, password resets, meeting
# invites). Example: smtps://user:password@mail.example.com:465
SMTP_URL=
MAIL_FROM="Selah <no-reply@example.com>"

# Readiness and alerts (docs/operations.md). OPS_TOKEN (openssl rand -hex 32)
# shows each check on /api/ready to the alert job and ops/readiness.sh.
# Alerts go to OPS_ALERT_EMAIL through SMTP_URL, and/or to OPS_ALERT_WEBHOOK.
OPS_TOKEN=
OPS_ALERT_EMAIL=
OPS_ALERT_WEBHOOK=

EMBED_MODEL=bge-m3
# Chat model. "ollama" runs locally (qwen3:4b fits a GTX 1050 class GPU).
# "openai_compat" uses a hosted API: sample data only unless approved.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b
LLM_API_BASE=
LLM_API_KEY=
# Mask client, people and department names before text goes to the model:
# "auto" masks whenever LLM_PROVIDER is a hosted API, "on" always, "off" never.
AI_MASKING=auto

# Password for the sample users created by `npm run db:seed`.
SEED_PASSWORD=

# Hosts besides Google Sheets that indicator sheet connections may read,
# comma-separated (docs/indicator-data.md). Usually empty.
INDICATOR_SHEET_HOSTS=
