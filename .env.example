# Copy to .env (for docker compose) and fill every value.
# Generate secrets with:  openssl rand -base64 32
# Never commit .env. Use synthetic data only until firm approves real data.

POSTGRES_PASSWORD=
SELAH_OWNER_PASSWORD=
SELAH_APP_PASSWORD=
SELAH_AUTH_PASSWORD=

BETTER_AUTH_SECRET=
AI_SERVICE_TOKEN=

S3_ACCESS_KEY=selah
S3_SECRET_KEY=
S3_BUCKET=selah-evidence

APP_URL=http://localhost:3000
EMBED_MODEL=bge-m3
# Chat model. "ollama" runs locally (qwen3:4b fits a GTX 1050 class GPU).
# "openai_compat" uses a hosted API: synthetic data only unless approved.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b
LLM_API_BASE=
LLM_API_KEY=

# Password for the synthetic demo users created by `npm run db:seed`.
SEED_PASSWORD=
